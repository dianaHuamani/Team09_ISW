# Para la app desplegada en EC2 dentro de la VPC, usa el endpoint privado de RDS:
# DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@ENDPOINT-RDS:3306/farmacia_inkafarma?charset=utf8mb4
# Desde tu PC mediante túnel SSH, usa 127.0.0.1:3307 en vez del endpoint:
# DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@127.0.0.1:3307/farmacia_inkafarma?charset=utf8mb4
# Si DATABASE_URL queda vacía, la app usa SQLite local (no RDS).
DATABASE_URL=
SECRET_KEY=change-this-before-deploying
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
FLASK_DEBUG=1
